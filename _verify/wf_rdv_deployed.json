    {
      "parameters": {
        "jsCode": "// Prépare le rappel J-7 / J-1 pour le rendez-vous courant\nconst apt = $('Loop Appointments').item.json;\nconst patient = $json;\n\n// N'envoyer un rappel que pour les RDV confirmés ou en attente.\nconst st = String(apt.status || '').toLowerCase();\nif (!(st === 'confirmed' || st === 'pending')) return [];\n\nconst TZ_OPTS = { timeZone: 'Africa/Tunis' };\nconst ymdFmt = new Intl.DateTimeFormat('en-CA', { ...TZ_OPTS, year: 'numeric', month: '2-digit', day: '2-digit' });\nconst tunisDayUtcMidnight = (dateObj) => {\n  const parts = {};\n  for (const part of ymdFmt.formatToParts(dateObj)) parts[part.type] = part.value;\n  return Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day));\n};\n\nconst todayMidnight = tunisDayUtcMidnight(new Date());\nconst rdvDate = new Date(apt.scheduled_at);\nconst rdvMidnight = tunisDayUtcMidnight(rdvDate);\nconst daysUntil = Math.round((rdvMidnight - todayMidnight) / 86400000);\n\nlet reminder_type = null;\nlet notification_type = null;\nif (daysUntil === 7) { reminder_type = 'j7'; notification_type = 'APPOINTMENT_REMINDER_7'; }\nelse if (daysUntil === 1) { reminder_type = 'j1'; notification_type = 'APPOINTMENT_REMINDER_1'; }\nif (!reminder_type) return [];\n\nconst dateStr = rdvDate.toLocaleDateString('fr-FR', { ...TZ_OPTS, day: '2-digit', month: '2-digit', year: 'numeric' });\nconst timeStr = rdvDate.toLocaleTimeString('fr-FR', { ...TZ_OPTS, hour: '2-digit', minute: '2-digit' });\nconst patientName = `${patient.first_name || ''} ${patient.last_name || ''}`.trim() || 'Patient';\nlet doctorName = apt.doctor_name || 'Médecin';\n\ndoctorName = doctorName || 'Médecin';\n\n// Sujets d'email selon la demande\nconst subject = reminder_type === 'j7'\n  ? 'Rappel de rendez-vous médical - J-7'\n  : 'Rappel de rendez-vous médical - Demain';\n\nconst typeLabel = reminder_type === 'j7' ? 'Rappel 7 jours avant' : 'Rappel 1 jour avant';\n\nconst message = `Bonjour ${patientName}, votre rendez-vous médical est prévu le ${dateStr} à ${timeStr}. Médecin: ${doctorName}. Type: ${typeLabel}.`;\n\nconst gmail_html = `<html><body>\n<h2>Rappel de rendez-vous médical</h2>\n<p>Bonjour <strong>${patientName}</strong>,</p>\n<p>Nous vous rappelons que votre rendez-vous médical est prévu le :</p>\n<ul>\n<li><strong>Date:</strong> ${dateStr}</li>\n<li><strong>Heure:</strong> ${timeStr}</li>\n<li><strong>Médecin:</strong> ${doctorName}</li>\n<li><strong>Type de notification:</strong> ${typeLabel}</li>\n</ul>\n<p>Cordialement,<br/>MedSecretariat</p>\n</body></html>`;\n\n// Destinataire reel: l'email du patient (aucune redirection de test)\nconst toEmail = patient.email || \"\";\n\nreturn [{\n  json: {\n    patient_id: apt.patient_id,\n    appointment_id: apt.id,\n    patient_name: patientName,\n    patient_email: toEmail,\n    title: subject,\n    message: message,\n    gmail_html: gmail_html,\n    reminder_type: reminder_type,\n    notification_type: notification_type,\n    dedup_key: `appointment:${apt.patient_id}:${apt.id}:${notification_type}`\n  }\n}];"
      },
