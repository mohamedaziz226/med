# Application
DEBUG=true
APP_NAME=MedSecretariat

# Database
DB_URL=postgresql+psycopg2://medsecretariat:medsecretariat@postgres:5432/medsecretariat

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_PRESIGNED_EXPIRY_SECONDS=900

# Redis
REDIS_URL=redis://redis:6379/0

# SMTP (leave empty for simulated mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@medsecretariat.local

# Twilio (leave empty for simulated mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/medsecretariat-calendar

# Workflows n8n (rappels de rendez-vous J-7/J-1 et de dettes J-15/J-10)
# MED_BACKEND_URL : http://app:8000 si n8n tourne dans Docker sinon http://localhost:8000
# Doit correspondre à un compte de rôle ADMIN avec 2FA désactivée
MED_BACKEND_URL=http://app:8000
MED_N8N_ADMIN_EMAIL=
MED_N8N_ADMIN_PASSWORD=

# Rappels backend (RDV J-7/J-1, dettes) gérés par APScheduler.
# Mettre ENABLE_BACKEND_REMINDERS=false si n8n prend en charge ces rappels
# pour éviter les doublons. Le nettoyage des documents reste toujours actif.
ENABLE_BACKEND_REMINDERS=true

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
