      "parameters": {
        "operation": "send",
        "fromEmail": "noreply@medsecretariat.test",
        "fromName": "MedSecretariat TEST",
        "toEmail": "={{ $json.patient_email }}",
        "subject": "={{ $json.title }}",
        "emailFormat": "html",
        "html": "={{ $json.gmail_html }}",
        "options": {}
      },
