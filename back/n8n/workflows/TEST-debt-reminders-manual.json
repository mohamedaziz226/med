      "id": "get-pat-debt",
      "name": "Get Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -500,
        0
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Recupere les paiements du patient + calcule la dette = somme(amount - amount_paid)\n// Renvoie TOUJOURS 1 item pour ne JAMAIS bloquer la boucle splitInBatches,\n// meme si le statut est non eligible, si la reponse est vide ou si l'API echoue.\nconst apt = $('Loop Appointments').item.json;\nconst patient = $json;\n\nconst st = String(apt.status || '').toLowerCase();\nconst eligible = (st === 'confirmed' || st === 'pending');\n\nlet debt = 0;\nif (eligible) {\n  try {\n    const token = $('Login Backend').first().json.access_token;\n    const res = await $http.request({\n      method: 'GET',\n      url: `${$env.MED_BACKEND_URL}/api/v1/payments?patient_id=${apt.patient_id}`,\n      headers: { Authorization: `Bearer ${token}` }\n    });\n    const payments = Array.isArray(res.data) ? res.data : [];\n    for (const p of payments) {\n      debt += (Number(p.amount) || 0) - (Number(p.amount_paid) || 0);\n    }\n  } catch (e) {\n    // Une erreur HTTP ne doit jamais tuer la boucle : dette = 0 -> IF false -> on reboucle.\n    debt = 0;\n  }\n}\ndebt = Math.round(debt * 100) / 100;\n\nreturn [{\n  json: {\n    patient_id: apt.patient_id,\n    appointment_id: apt.id,\n    appointment_scheduled_at: apt.scheduled_at,\n    patient_name: `${patient.first_name || ''} ${patient.last_name || ''}`.trim() || 'Patient',\n    patient_email: patient.email || '',\n    debt\n  }\n}];"
      },
      "id": "calc-debt",
      "name": "Calculate Debt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if-debt-1",
              "leftValue": "={{ Number($json.debt) }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-debt",
      "name": "IF Debt > 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        360,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Calcule le jour du rappel J-15 / J-10 et génère le message.\n// TOUJOURS renvoyer un item (même si hors seuil) pour ne pas casser la\n// boucle splitInBatches : reminder_type=null → l'IF suivant rebouclera.\nconst item = $json;\n\nconst now = new Date();\nnow.setHours(0, 0, 0, 0);\nconst d = new Date(item.appointment_scheduled_at);\nd.setHours(0, 0, 0, 0);\nconst daysUntil = Math.round((d - now) / 86400000);\n\nlet reminder_type = null;\nif (daysUntil === 15) reminder_type = 'j15';\nelse if (daysUntil === 10) reminder_type = 'j10';\n\n// Hors seuil : on renvoie quand même l'item avec reminder_type=null.\n// Le nœud IF Eligible Reminder filtrera et rebouclera vers Loop Appointments.\nif (!reminder_type) {\n  return [{ json: { ...item, reminder_type: null } }];\n}\n\nconst dateStr = d.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit', year: 'numeric' });\nconst debtStr = Number(item.debt).toFixed(2);\nconst title = 'Rappel de paiement';\nconst message = `Bonjour ${item.patient_name}, nous vous informons qu'un montant de ${debtStr} DT reste à régler sur votre dossier. Votre prochain rendez-vous est prévu le ${dateStr}. Nous vous invitons à régulariser votre situation avant cette date.`;\n\nreturn [{\n  json: {\n    ...item,\n    reminder_type,\n    appointment_date: dateStr,\n    title,\n    message,\n    gmail_html: `<p>Bonjour ${item.patient_name},</p><p>Nous vous informons qu'un montant de <strong>${debtStr} DT</strong> reste à régler sur votre dossier.</p><p>Votre prochain rendez-vous est prévu le <strong>${dateStr}</strong>.</p><p>Nous vous invitons à régulariser votre situation avant cette date.</p><p>Cordialement,<br/>MedSecretariat</p>`\n  }\n}]"
      },
      "id": "prepare-debt",
      "name": "Generate Debt Reminder Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1.0,
      "position": [
        640,
        0
      ]
    },
