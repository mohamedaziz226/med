    "Get Patient": {
      "main": [
        [
          {
            "node": "Prepare Reminders",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Reminders": {
      "main": [
        [
          {
            "node": "If Reminder Day (J-7 / J-1)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Reminder Day (J-7 / J-1)": {
      "main": [
