            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Loop Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send a Message": {
      "main": [
        [
          {
            "node": "Create Patient Notification",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Patient Notification": {
      "main": [
        [
          {
            "node": "Loop Appointments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
