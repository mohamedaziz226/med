{
  "name": "MedSecretariat â€” Rappels de rendez-vous (J-7/J-1) + notifications patient",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * *"
            }
          ]
        }
      },
      "id": "schedule-rdv",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        -1400,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MED_BACKEND_URL }}/api/v1/auth/login",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"email\": \"{{ $env.MED_N8N_ADMIN_EMAIL }}\",\n  \"password\": \"{{ $env.MED_N8N_ADMIN_PASSWORD }}\"\n}",
        "options": {}
      },
      "id": "login-rdv",
      "name": "Login Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1150,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MED_BACKEND_URL }}/api/v1/appointments/upcoming",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Login Backend').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-rdv",
      "name": "Get Upcoming Appointments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -900,
        0
      ]
    },
    {
      "parameters": {},
      "id": "loop-rdv",
      "name": "Loop Appointments",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -600,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.MED_BACKEND_URL }}/api/v1/patients/{{ $('Loop Appointments').item.json.patient_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Login Backend').first().json.access_token }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-pat-rdv",
      "name": "Get Patient",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// PrÃ©pare le rappel J-7 / J-1 pour le rendez-vous courant\n// Le calcul des jours est EXPLICITEMENT basÃ© sur Africa/Tunis (fuseau mÃ©tier\n// du cabinet) et non sur le fuseau implicite du processus â€” y compris pour\n// les rendez-vous proches de minuit.\nconst apt = $('Loop Appointments').item.json;\nconst patient = $json;\n\n// N'envoyer un rappel que pour les RDV confirmÃ©s ou en attente.\n// Ignore CANCELLED, REJECTED, COMPLETED, NO_SHOW.\nconst st = String(apt.status || '').toLowerCase();\nif (!(st === 'confirmed' || st === 'pending')) return [];\n\nconst TZ_OPTS = { timeZone: 'Africa/Tunis' };\nconst ymdFmt = new Intl.DateTimeFormat('en-CA', { ...TZ_OPTS, year: 'numeric', month: '2-digit', day: '2-digit' });\nconst tunisDayUtcMidnight = (dateObj) => {\n  const parts = {};\n  for (const part of ymdFmt.formatToParts(dateObj)) parts[part.type] = part.value;\n  return Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day));\n};\n\nconst todayMidnight = tunisDayUtcMidnight(new Date());\nconst rdvDate = new Date(apt.scheduled_at);\nconst rdvMidnight = tunisDayUtcMidnight(rdvDate);\nconst daysUntil = Math.round((rdvMidnight - todayMidnight) / 86400000);\n\nlet reminder_type = null;\nif (daysUntil === 7) reminder_type = 'j7';\nelse if (daysUntil === 1) reminder_type = 'j1';\nif (!reminder_type) return [];\n\nconst dateStr = rdvDate.toLocaleDateString('fr-FR', { ...TZ_OPTS, day: '2-digit', month: '2-digit', year: 'numeric' });\nconst timeStr = rdvDate.toLocaleTimeString('fr-FR', { ...TZ_OPTS, hour: '2-digit', minute: '2-digit' });\nconst patientName = `${patient.first_name || ''} ${patient.last_name || ''}`.trim() || 'Patient';\nconst title = reminder_type === 'j7' ? 'Rappel de rendez-vous' : 'Rappel de rendez-vous demain';\nconst message = reminder_type === 'j7'\n  ? `Bonjour ${patientName}, votre rendez-vous mÃ©dical est prÃ©vu dans 7 jours, le ${dateStr} Ã  ${timeStr}.`\n  : `Bonjour ${patientName}, nous vous rappelons que votre rendez-vous mÃ©dical est prÃ©vu demain, le ${dateStr} Ã  ${timeStr}.`;\n\nreturn [{\n  json: {\n    patient_id: apt.patient_id,\n    appointment_id: apt.id,\n    patient_name: patientName,\n    patient_email: patient.email || '',\n    appointment_date: dateStr,\n    appointment_time: timeStr,\n    reminder_type,\n    title,\n    message,\n    gmail_html: `<p>Bonjour ${patientName},</p><p>${message}</p><p>Cordialement,<br/>MedSecretariat</p>`\n  }\n}]"
      },
      "id": "prepare-rdv",
      "name": "Prepare Reminders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1.0,
      "position": [
        -60,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if-rdv-1",
              "leftValue": "={{ $json.reminder_type }}",
              "rightValue": "",
              "operator": {
                "type": "empty",
                "operation": "notEmpty"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-rdv",
      "name": "If Reminder Day (J-7 / J-1)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        80,
        0
      ]
    },
    {
      "parameters": {
        "operation": "send",
        "message": {
          "to": "={{ $json.patient_email }}",
          "subject": "={{ $json.title }}",
          "emailType": "html",
          "message": "={{ $json.gmail_html }}"
        },
        "options": {}
      },
      "credentials": {
        "gmailOAuth2": {
          "id": "CaiZmZzshoECZ5OO",
          "name": "Gmail account"
        }
      },
      "id": "gmail-rdv",
      "name": "Send a Message",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        300,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MED_BACKEND_URL }}/api/v1/notifications",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"patient_id\": {{ $json.patient_id }},\n  \"title\": \"{{ $json.title }}\",\n  \"message\": \"{{ $json.message }}\",\n  \"type\": \"appointment_reminder\",\n  \"related_entity_id\": {{ $json.appointment_id }},\n  \"related_entity_type\": \"appointment\",\n  \"reminder_type\": \"{{ $json.reminder_type }}\"\n}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Login Backend').first().json.access_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "create-notif-rdv",
      "name": "Create Patient Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -120
      ]
    },
    {
      "parameters": {},
      "id": "finish-rdv",
      "name": "End",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1.0,
      "position": [
        900,
        -60
      ]
    }
  ],
  "connections": {
