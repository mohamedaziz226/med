    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Calcule la dette du patient courant (paiements aggrégés)\nconst apt = $('Loop Appointments').first().json;\nconst patient = $('Get Patient').first().json;\n\nconst st = String(apt.status || '').toLowerCase();\nconst eligible = (st === 'confirmed' || st === 'pending');\n\nlet debt = 0;\nif (eligible) {\n  const arr = Array.isArray($json.payments) ? $json.payments : [];\n  for (const p of arr) {\n    if (p && p.amount != null && p.amount !== undefined) {\n      debt += (Number(p.amount) || 0) - (Number(p.amount_paid) || 0);\n    }\n  }\n}\ndebt = Math.round(debt * 100) / 100;\n\nreturn {\n  json: {\n    patient_id: apt.patient_id,\n    appointment_id: apt.id,\n    appointment_scheduled_at: apt.scheduled_at,\n    patient_name: `${patient.first_name || ''} ${patient.last_name || ''}`.trim() || 'Patient',\n    patient_email: patient.email || '',\n    debt\n  }\n};"
      },
      "id": "calc-debt",
      "name": "Calculate Debt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        60,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "if-debt-1",
              "leftValue": "={{ Number($json.debt) }}",
              "rightValue": "0",
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "if-debt",
      "name": "IF Debt > 0",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        360,
        0
      ]
